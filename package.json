{
  "name": "dsh-agent-instructions",
  "version": "0.4.12",
  "description": "在 dsh Web 设置页里编辑原生 AGENTS.md 的面板：指令链上每一层都是可点击的编辑入口，三种生效范围（工作区 + 全局 / 仅工作区 / 仅全局）通过给文件名加 .disabled 切换（内容不删），并可视化官方指令预算与分层占用。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bay-Zeddie/dsh-agent-instructions.git"
  },
  "homepage": "https://github.com/Bay-Zeddie/dsh-agent-instructions#readme",
  "bugs": {
    "url": "https://github.com/Bay-Zeddie/dsh-agent-instructions/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "agents-md",
    "agent-profile"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
